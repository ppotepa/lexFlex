// English verb paradigms

[
    (name: "verb_regular", rules: [
        (conditions: [TenseIs(Present), PersonIs(Third), NumberIs(Singular)], operations: [AddSuffix("s")]),
        (conditions: [TenseIs(Present)], operations: []),
        // Past tense with consonant doubling for CVC pattern (stop → stopped)
        (conditions: [TenseIs(Past)], operations: [DoubleFinalConsonant, AddSuffix("ed")]),
    ]),
]
