(
    schema_version: 1,
    id: "document-mvp-v1",
    display_name: "Document MVP V1 - Polish to English",
    source_language: "pl",
    target_language: "en",
    blocking_direction: true,
    input: (
        format: PlainText,
        encoding: "UTF-8",
        preserve_paragraphs: true,
        paragraph_separator: BlankLine,
        max_bytes: Some(262144),
        allow_crlf: true,
    ),
    length_tiers: [
        (
            id: "micro",
            min_words: Some(20),
            max_words: Some(100),
            min_sentences: Some(2),
            max_sentences: Some(4),
            min_paragraphs: Some(1),
            max_paragraphs: Some(2),
            blocking: true,
        ),
        (
            id: "short",
            min_words: Some(70),
            max_words: Some(300),
            min_sentences: Some(5),
            max_sentences: Some(12),
            min_paragraphs: Some(1),
            max_paragraphs: Some(4),
            blocking: true,
        ),
        (
            id: "standard",
            min_words: Some(200),
            max_words: Some(1200),
            min_sentences: Some(10),
            max_sentences: Some(40),
            min_paragraphs: Some(2),
            max_paragraphs: Some(10),
            blocking: false,
        ),
        (
            id: "stress",
            min_words: Some(1200),
            max_words: None,
            min_sentences: Some(40),
            max_sentences: None,
            min_paragraphs: Some(1),
            max_paragraphs: None,
            blocking: false,
        ),
    ],
    capabilities: [
        (id: "DOC-STR-001", name: "Multi-sentence input", status: Required, blocking: true, corpus_tag: "multi_sentence", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-STR-002", name: "Multi-paragraph input", status: Required, blocking: true, corpus_tag: "multi_paragraph", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-REF-001", name: "Repeated proper name", status: Required, blocking: true, corpus_tag: "proper_name_chain", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-REF-002", name: "Personal pronoun chain", status: Required, blocking: true, corpus_tag: "pronoun_chain", minimum_cases: 4, target_chapter: 1),
        (id: "DOC-REF-003", name: "Polish zero subject", status: Required, blocking: true, corpus_tag: "zero_anaphora", minimum_cases: 4, target_chapter: 1),
        (id: "DOC-TIM-001", name: "Narrative tense continuity", status: Required, blocking: true, corpus_tag: "tense_continuity", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-TIM-002", name: "Temporal sequencing", status: Required, blocking: true, corpus_tag: "temporal_sequence", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-001", name: "Preserve negation", status: Required, blocking: true, corpus_tag: "negation", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-002", name: "Preserve numbers", status: Required, blocking: true, corpus_tag: "number", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-003", name: "Preserve semantic roles", status: Required, blocking: true, corpus_tag: "semantic_roles", minimum_cases: 4, target_chapter: 1),
        (id: "DOC-LEX-001", name: "Terminology consistency", status: Required, blocking: true, corpus_tag: "terminology", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-DIS-001", name: "Cause/result relation", status: Required, blocking: true, corpus_tag: "causal", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-DIS-002", name: "Contrast relation", status: Required, blocking: true, corpus_tag: "contrast", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-CLA-001", name: "Complement clause", status: Tracked, blocking: false, corpus_tag: "complement_clause", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-CLA-002", name: "Relative clause", status: Tracked, blocking: false, corpus_tag: "relative_clause", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-MWE-001", name: "Multi-word expression", status: Tracked, blocking: false, corpus_tag: "mwe", minimum_cases: 3, target_chapter: 2),
        (id: "DOC-FMT-001", name: "Paragraph preservation", status: Required, blocking: true, corpus_tag: "paragraph_structure", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-FMT-002", name: "Rich text formatting", status: Deferred, blocking: false, corpus_tag: "rich_text", minimum_cases: 0, target_chapter: 3),
        (id: "DOC-SEM-004", name: "Quantifiers", status: Required, blocking: true, corpus_tag: "quantifier", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-005", name: "Goal source location", status: Required, blocking: true, corpus_tag: "location_goal", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-006", name: "Coordination", status: Required, blocking: true, corpus_tag: "coordination", minimum_cases: 3, target_chapter: 1),
        (id: "DOC-SEM-007", name: "Definiteness", status: Tracked, blocking: false, corpus_tag: "definiteness", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-SEM-008", name: "Possession", status: Required, blocking: true, corpus_tag: "possession", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-009", name: "Communication", status: Tracked, blocking: false, corpus_tag: "communication", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-SEM-010", name: "Topic continuation", status: Required, blocking: true, corpus_tag: "topic_continuation", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-011", name: "Topic shift", status: Required, blocking: true, corpus_tag: "topic_shift", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-012", name: "Instructional sequence", status: Tracked, blocking: false, corpus_tag: "instruction_sequence", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-SEM-013", name: "Factual description", status: Tracked, blocking: false, corpus_tag: "factual_description", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-SEM-014", name: "Numbers and quantities", status: Required, blocking: true, corpus_tag: "numbers_and_quantities", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-015", name: "Proper names and cities", status: Required, blocking: true, corpus_tag: "proper_names_cities", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-016", name: "Motion chain", status: Required, blocking: true, corpus_tag: "motion_chain", minimum_cases: 2, target_chapter: 1),
        (id: "DOC-SEM-017", name: "Reporting verb", status: Tracked, blocking: false, corpus_tag: "reporting_verb", minimum_cases: 2, target_chapter: 2),
        (id: "DOC-SEM-018", name: "Standard mixed document", status: Deferred, blocking: false, corpus_tag: "standard_mixed", minimum_cases: 1, target_chapter: 3),
    ],
    quality_gates: (
        require_deterministic_output: true,
        require_non_empty_output: true,
        max_fatal_errors: 0,
        required_name_preservation: 1.0,
        required_number_preservation: 1.0,
        required_negation_preservation: 1.0,
        required_reference_accuracy: 0.95,
        required_zero_anaphora_accuracy: 0.90,
        required_frame_signature_recall: 0.95,
        required_glossary_compliance: 0.95,
        required_paragraph_preservation: 0.99,
    ),
    error_severity: [
        (category: "panic", severity: Fatal),
        (category: "empty_output", severity: Fatal),
        (category: "missing_paragraph", severity: Fatal),
        (category: "hallucinated_critical_fact", severity: Fatal),
        (category: "lost_negation", severity: Fatal),
        (category: "changed_number", severity: Fatal),
        (category: "role_swap", severity: Fatal),
        (category: "wrong_coreference", severity: Major),
        (category: "wrong_tense", severity: Major),
        (category: "wrong_frame", severity: Major),
        (category: "terminology_inconsistent", severity: Major),
        (category: "article", severity: Minor),
        (category: "agreement", severity: Minor),
        (category: "word_order", severity: Minor),
        (category: "punctuation", severity: Minor),
    ],
)
